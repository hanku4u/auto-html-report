{#-
 # The page shell. The document is rendered by render_report(report) in rendering/shell.py.
 #
 # Autoescaping is ON, and every framework interpolation below relies on it: title, subtitle,
 # metadata, run id, item text and block ids are all untrusted enough to escape. See
 # docs/06-output-html.md §4.
 #
 # There is exactly ONE `|safe` in this codebase, below, and it is the trust boundary: row.html is
 # HTML a block produced, and a block owns escaping whatever it put in it (ADR-0012).
-#}
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ report.title }} — {{ report.title_timestamp }}</title>
  <style>{% include "report.css" %}</style>
</head>
<body class="ai-report">
  <header class="ai-header">
    <h1 class="ai-header__title">{{ report.title }}</h1>
{% if report.subtitle %}
    <p class="ai-header__subtitle">{{ report.subtitle }}</p>
{% endif %}
    <dl class="ai-header__meta">
      <dt>Run</dt><dd>{{ report.run_id }}</dd>
      <dt>Generated</dt><dd>{{ report.generated_at_iso }}</dd>
{% for name, value in report.metadata %}
      <dt>{{ name }}</dt><dd>{{ value }}</dd>
{% endfor %}
    </dl>
  </header>

  <table class="ai-table">
    <colgroup>
      <col class="ai-col--item"><col class="ai-col--data"><col class="ai-col--check">
    </colgroup>
    <thead>
      <tr><th scope="col">Item</th><th scope="col">Data</th><th scope="col">Check</th></tr>
    </thead>
    <tbody>
{% for row in report.rows %}
      <tr class="ai-row" data-block="{{ row.block_id }}">
        <td class="ai-cell ai-cell--item">{{ row.item }}</td>
        <td class="ai-cell ai-cell--data{% if row.is_error %} ai-cell--error{% endif %}">{{ row.html | safe }}</td>
        <td class="ai-cell ai-cell--check"></td>
      </tr>
{% endfor %}
    </tbody>
  </table>

  <footer class="ai-footer">auto_html_report {{ report.tool_version }}</footer>
</body>
</html>
